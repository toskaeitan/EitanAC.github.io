---
import Icon from "@components/atoms/display/Icon.svelte";
import Key from "@i18n/i18nKey";
import { i18n } from "@i18n/translation";
import { url } from "@utils/url-utils";
import type { ProjectItem } from "@/types/projectsConfig";
interface Props {
	project?: ProjectItem;
	showMoments?: boolean;
	showIntro?: boolean;
}
const { project, showMoments = false, showIntro = true } = Astro.props;
---
<section class="home-overview" aria-labelledby={showIntro ? "home-title" : undefined}>
 {showIntro && <div class="home-intro">
  <h1 id="home-title">{i18n(Key.homeIntroTitle)}</h1>
  <p>{i18n(Key.homeIntroDescription)}</p>
  <nav class="home-paths" aria-label={i18n(Key.home)}>
   <a href={url('/archive/')} class="m3-state-layer">{i18n(Key.homeRead)}<Icon icon="material-symbols:arrow-forward-rounded" /></a>
   {showMoments && <a href={url('/moments/')} class="m3-state-layer">{i18n(Key.homeNotes)}<Icon icon="material-symbols:arrow-forward-rounded" /></a>}
  </nav>
 </div>}
 <slot />
 {project && <section class="home-project" aria-labelledby="home-project-heading">
  <div class="home-section-heading"><h2 id="home-project-heading">{i18n(Key.homeFeaturedProject)}</h2><a href={url('/projects/')}>{i18n(Key.homeBuild)}<Icon icon="material-symbols:arrow-forward-rounded" /></a></div>
  <div class="home-project-body">
   <div class="home-project-mark" aria-hidden="true">
    {project.logo ? <>
     <img src={project.logo} alt="" width="48" height="48" onerror="this.nextElementSibling.hidden=false;this.remove()" />
     <span hidden><Icon icon={project.icon || 'material-symbols:deployed-code-outline-rounded'} /></span>
    </> : <Icon icon={project.icon || 'material-symbols:deployed-code-outline-rounded'} />}
   </div>
   <div><h3>{project.title}</h3><p>{project.summary}</p></div>
  </div>
  <div class="home-project-footer"><ul>{project.technologies?.map(tech => <li>{tech}</li>)}</ul>{project.website && <a href={project.website} target="_blank" rel="noopener noreferrer" class="home-visit m3-state-layer">{i18n(Key.projectVisit)}<Icon icon="material-symbols:arrow-outward-rounded" /></a>}</div>
 </section>}
</section>
<style>
.home-overview { margin-bottom: var(--m3e-space-8); }
.home-intro { padding: clamp(1.5rem, 5vw, 3.5rem) clamp(1.25rem, 4vw, 3rem); background: var(--surface-container); border-radius: var(--shape-corner-m); }
h1 { margin: 0; max-width: 18ch; font-size: clamp(1.9rem, 3.2vw, 2.8rem); font-weight: 600; line-height: 1.55; text-wrap: balance; color: var(--on-surface); }
.home-intro p { max-width: 34em; margin: var(--m3e-space-4) 0 var(--m3e-space-8); color: var(--on-surface-variant); font-size: 1rem; line-height: 1.9; }
.home-paths { display: flex; flex-wrap: wrap; gap: var(--m3e-space-6); }
a { display: inline-flex; align-items: center; gap: var(--m3e-space-2); color: var(--primary); text-decoration: none; min-height: 2.75rem; }
a:hover { text-decoration: underline; text-underline-offset: .3em; }
a:focus-visible { outline: 2px solid var(--primary); outline-offset: 4px; }
.home-project { padding: var(--m3e-space-8) var(--m3e-space-4) 0; }
.home-section-heading { display: flex; align-items: center; justify-content: space-between; flex-wrap: wrap; gap: var(--m3e-space-2); padding-bottom: var(--m3e-space-4); border-bottom: 1px solid var(--outline-variant); }
h2 { margin: 0; font-size: 1.25rem; font-weight: 600; }
.home-section-heading a { font-size: .875rem; }
.home-project-body { display: grid; grid-template-columns: 3rem minmax(0,1fr); gap: var(--m3e-space-4); padding-block: var(--m3e-space-6); }
.home-project-mark { font-size: 2rem; color: var(--primary); padding-top: .25rem; }
.home-project-mark img { display: block; width: 3rem; height: 3rem; object-fit: contain; }
h3 { margin: 0 0 var(--m3e-space-3); font-size: 1.6rem; font-weight: 600; line-height: 1.5; }
.home-project-body p { margin: 0; max-width: 42em; font-size: 1rem; line-height: 1.95; color: var(--on-surface-variant); overflow-wrap: anywhere; }
.home-project-footer { display: flex; flex-wrap: wrap; align-items: center; justify-content: space-between; gap: var(--m3e-space-4); padding-left: 4rem; }
ul { display: flex; flex-wrap: wrap; gap: var(--m3e-space-4); list-style: none; margin: 0; padding: 0; color: var(--on-surface-variant); font-size: .875rem; }
.home-visit { padding-inline: var(--m3e-space-4); background: var(--primary-container); border-radius: var(--shape-corner-s); }
@media (max-width: 480px) { .home-project { padding-inline: var(--m3e-space-2); } .home-project-footer { padding-left: 0; } }
</style>

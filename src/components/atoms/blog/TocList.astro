---
import Icon from "@components/atoms/display/Icon.svelte";
import I18nKey from "@i18n/i18nKey";
import { i18n } from "@i18n/translation";
import { buildTocTree, type TocHeading } from "@utils/toc-tree";
interface Props {
	headings: TocHeading[];
	maxDepth?: number;
	class?: string;
	collapsible?: boolean;
}
const {
	headings = [],
	maxDepth = 3,
	class: className,
	collapsible = false,
} = Astro.props;
const nodes = buildTocTree(headings, maxDepth);
let counter = 0;
---
<nav class:list={['m3-blog-toc', className, { 'm3-blog-toc--tree': collapsible }]} aria-label={i18n(I18nKey.tableOfContents)}>
 {nodes.map((h, index) => <div class="m3-blog-toc__row" data-toc-parent={h.parent} style={`--toc-level:${h.level}`}>
  <a class:list={['m3-blog-toc__item', { 'm3-blog-toc__item--sub': h.level > 0 }]} href={`#${h.slug}`} title={h.text} data-toc-depth={h.depth}>
   <span class="m3-blog-toc__mark" aria-hidden="true">{h.level === 0 ? ++counter : <span class="m3-blog-toc__dot" />}</span>
   <span class="m3-blog-toc__text">{h.text}</span>
  </a>
  {collapsible && h.hasChildren && <button type="button" class="m3-blog-toc__toggle m3-state-layer" data-toc-toggle={index} aria-expanded="true" aria-label={i18n(I18nKey.tocToggleSection).replace('{title}', h.text)}><Icon icon="material-symbols:expand-more-rounded" /></button>}
 </div>)}
</nav>
